{
  "name": "better-pdf",
  "version": "0.0.0",
  "description": "A maintained, fast alternative to pdf-lib for filling and flattening PDF AcroForms.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "import": "./dist/index.browser.js"
    },
    "./typegen": {
      "types": "./dist/typegen.d.ts",
      "import": "./dist/typegen.js"
    }
  },
  "bin": {
    "better-pdf-generate-types": "./dist/bin/generate-types.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "pkg/package.json",
    "pkg/better_pdf_core.js",
    "pkg/better_pdf_core.d.ts",
    "pkg/better_pdf_core_bg.wasm",
    "pkg/better_pdf_core_bg.wasm.d.ts",
    "pkg-web/package.json",
    "pkg-web/better_pdf_core.js",
    "pkg-web/better_pdf_core.d.ts",
    "pkg-web/better_pdf_core_bg.wasm",
    "pkg-web/better_pdf_core_bg.wasm.d.ts",
    "README.md",
    "LICENSE",
    "skills/better-pdf/SKILL.md"
  ],
  "keywords": [
    "pdf",
    "acroform",
    "forms",
    "wasm",
    "pdf-lib"
  ],
  "scripts": {
    "build:wasm:node": "wasm-pack build crates/core --target nodejs --out-dir ../../pkg --out-name better_pdf_core",
    "build:wasm:browser": "wasm-pack build crates/core --target web --out-dir ../../pkg-web --out-name better_pdf_core",
    "build:wasm": "bun run build:wasm:node && bun run build:wasm:browser",
    "build:js": "tsc -p tsconfig.build.json",
    "build": "bun run build:wasm && bun run build:js",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test:browser-entry": "bun run build && bun run scripts/browser-entry-smoke.ts",
    "test": "bun test",
    "play": "bun run examples/playground.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^6"
  }
}
