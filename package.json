{
  "name": "@ignaciano3/better-pdf",
  "version": "0.1.0",
  "description": "A maintained, fast alternative to pdf-lib for filling and flattening PDF AcroForms.",
  "type": "module",
  "author": "Ignacio Garcia P <ignaciogp08@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignaciano3/better-pdf.git"
  },
  "homepage": "https://github.com/ignaciano3/better-pdf#readme",
  "bugs": {
    "url": "https://github.com/ignaciano3/better-pdf/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "import": "./dist/index.browser.js"
    },
    "./typegen": {
      "types": "./dist/typegen.d.ts",
      "import": "./dist/typegen.js"
    }
  },
  "bin": {
    "better-pdf-generate-types": "./dist/bin/generate-types.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "pkg-web/package.json",
    "pkg-web/better_pdf_core.js",
    "pkg-web/better_pdf_core.d.ts",
    "pkg-web/better_pdf_core_bg.wasm",
    "pkg-web/better_pdf_core_bg.wasm.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "skills/better-pdf/SKILL.md"
  ],
  "keywords": [
    "pdf",
    "acroform",
    "forms",
    "wasm",
    "pdf-lib"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/core --target web --out-dir ../../pkg-web --out-name better_pdf_core",
    "build:js": "tsc -p tsconfig.build.json",
    "build": "bun run build:wasm && bun run build:js",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test:browser-entry": "bun run build && bun run scripts/browser-entry-smoke.ts",
    "test:browser": "bun run build && bun run scripts/browser-real-test.ts",
    "test": "bun test",
    "play": "bun run examples/playground.ts",
    "bench": "bun run bench/bench.ts",
    "docs": "typedoc"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6"
  }
}
